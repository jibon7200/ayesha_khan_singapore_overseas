# ==========================================================
# Ayesha Khan Singapore Overseas - Environment Variables
# কপি করে ".env" নামে সেভ করুন এবং নিজের মান বসান
# ==========================================================

SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------- Database (PostgreSQL) ----------------
# Local development-এ চাইলে SQLite ব্যবহার করতে পারবেন (settings.py দেখুন)
DB_NAME=ayesha_khan_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------- WhatsApp Business API (ভবিষ্যতে যোগ করবেন) ----------------
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_ENABLED=False

# ---------------- Email (ভবিষ্যতে যোগ করবেন) ----------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True

# ---------------- OCR ----------------
TESSERACT_CMD=/usr/bin/tesseract
